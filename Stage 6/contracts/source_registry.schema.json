{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage6/source_registry.schema.json",
  "title": "Stage 6 Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_snapshot_id", "registry_version", "as_of_timestamp", "previous_registry_hash", "registry_hash", "sources"],
  "properties": {
    "schema_version": {"const": "STAGE6_SOURCE_REGISTRY_V1"},
    "registry_snapshot_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "integer", "minimum": 1},
    "as_of_timestamp": {"type": "string", "format": "date-time"},
    "previous_registry_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "registry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_name", "authority_level", "publisher_type", "jurisdiction", "coverage", "expected_latency", "supports_machine_access", "historical_depth", "requires_auth", "cost_class", "terms_notes", "enabled", "verification_status", "source_record_version", "effective_from", "effective_to", "reviewed_at_utc", "access_method", "machine_endpoint_type", "licensing_or_terms_status", "automation_allowed_status", "rate_limit_notes", "availability_notes", "previous_version_hash", "record_hash"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_name": {"type": "string", "minLength": 1},
        "authority_level": {"enum": ["PRIMARY_OFFICIAL", "AUTHORITATIVE_INDEPENDENT", "DISCOVERY", "UNVERIFIED"]},
        "publisher_type": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "coverage": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "expected_latency": {"type": "string", "minLength": 1},
        "supports_machine_access": {"type": "boolean"},
        "historical_depth": {"type": ["string", "null"]},
        "requires_auth": {"type": "boolean"},
        "cost_class": {"enum": ["FREE", "FREEMIUM", "PAID", "UNKNOWN"]},
        "terms_notes": {"type": "string"},
        "enabled": {"type": "boolean"},
        "verification_status": {"enum": ["VERIFIED", "PENDING_REVIEW", "DISABLED", "REJECTED"]},
        "source_record_version": {"type": "integer", "minimum": 1},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "reviewed_at_utc": {"type": "string", "format": "date-time"},
        "access_method": {"enum": ["MANUAL_DOWNLOAD", "PUBLIC_API", "MACHINE_FEED", "WEB_PUBLICATION", "OTHER", "NONE"]},
        "machine_endpoint_type": {"enum": ["REST", "RSS_ATOM", "BULK_FILE", "WEBSOCKET", "GRAPHQL", "HTML", "OTHER", "NONE"]},
        "licensing_or_terms_status": {"enum": ["REVIEWED_ALLOWED", "REVIEWED_RESTRICTED", "PENDING_REVIEW", "UNKNOWN"]},
        "automation_allowed_status": {"enum": ["ALLOWED", "RESTRICTED", "PROHIBITED", "UNKNOWN"]},
        "rate_limit_notes": {"type": ["string", "null"]},
        "availability_notes": {"type": ["string", "null"]},
        "previous_version_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "x-stage6-invariants": ["Authority, access, availability, licensing, and automation changes create new source-record and registry-snapshot versions; historical records and snapshots are never overwritten.", "Changing one source record changes registry_snapshot_id, registry_version, and registry_hash; historical acquisitions retain the exact prior snapshot binding.", "No credentials are stored in the registry."]
}
