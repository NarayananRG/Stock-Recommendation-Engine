{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage6/shadow_decision.schema.json",
  "title": "Stage 6 Reproducible Shadow Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "decision_engine_version", "code_commit", "as_of_timestamp", "decision_cutoff_timestamp", "ticker", "decision_scope", "original_thesis_id", "decision", "supporting_evidence_ids", "historical_analogue_id", "market_context_id", "portfolio_context_id", "input_records", "source_registry_version", "entity_registry_version", "previous_decision_id", "reason_codes", "human_readable_explanation", "confidence", "record_hash", "authority_mode"],
  "properties": {
    "schema_version": {"const": "STAGE6_SHADOW_DECISION_V2"},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_engine_version": {"type": "string", "minLength": 1},
    "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "as_of_timestamp": {"type": "string", "format": "date-time"},
    "decision_cutoff_timestamp": {"type": "string", "format": "date-time"},
    "ticker": {"type": "string", "minLength": 1},
    "decision_scope": {"enum": ["NEW_ENTRY", "HOLDING"]},
    "original_thesis_id": {"type": ["string", "null"]},
    "decision": {"enum": ["ENTRY_VALID", "WAIT", "CANCEL_ENTRY", "PRICE_OUTSIDE_ENTRY_RANGE", "NO_NEW_POSITION", "HOLD", "HOLD_RAISE_STOP", "HOLD_EXTEND_TARGET", "RISK_REVIEW", "REDUCE", "EXIT"]},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "historical_analogue_id": {"type": ["string", "null"]},
    "market_context_id": {"type": "string", "minLength": 1},
    "portfolio_context_id": {"type": "string", "minLength": 1},
    "input_records": {"type": "array", "items": {"$ref": "#/$defs/input_record_binding"}, "minItems": 1},
    "source_registry_version": {"type": "string", "minLength": 1},
    "entity_registry_version": {"type": "string", "minLength": 1},
    "previous_decision_id": {"type": ["string", "null"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "human_readable_explanation": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority_mode": {"const": "SHADOW_ONLY"}
  },
  "$defs": {"input_record_binding": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_hash", "record_type"], "properties": {"record_id": {"type": "string", "minLength": 1}, "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "record_type": {"type": "string", "minLength": 1}}}},
  "allOf": [
    {"if": {"properties": {"decision_scope": {"const": "NEW_ENTRY"}}}, "then": {"properties": {"decision": {"enum": ["ENTRY_VALID", "WAIT", "CANCEL_ENTRY", "PRICE_OUTSIDE_ENTRY_RANGE", "NO_NEW_POSITION"]}}}},
    {"if": {"properties": {"decision_scope": {"const": "HOLDING"}}}, "then": {"properties": {"decision": {"enum": ["HOLD", "HOLD_RAISE_STOP", "HOLD_EXTEND_TARGET", "RISK_REVIEW", "REDUCE", "EXIT"]}, "original_thesis_id": {"type": "string", "minLength": 1}}}}
  ],
  "x-stage6-invariants": ["decision_cutoff_timestamp is the latest permissible input time and must not be after as_of_timestamp.", "Each input_records entry binds one dependency ID directly to its immutable hash and stable type.", "All decisions remain SHADOW_ONLY and have zero production authority."]
}
