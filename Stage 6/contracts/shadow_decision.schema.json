{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage6/shadow_decision.schema.json",
  "title": "Stage 6 Shadow Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "as_of_timestamp", "ticker", "decision_scope", "original_thesis_id", "decision", "supporting_evidence_ids", "historical_analogue_id", "market_context_id", "portfolio_context_id", "reason_codes", "human_readable_explanation", "confidence", "authority_mode"],
  "properties": {
    "schema_version": {"const": "STAGE6_SHADOW_DECISION_V1"},
    "decision_id": {"type": "string", "minLength": 1},
    "as_of_timestamp": {"type": "string", "format": "date-time"},
    "ticker": {"type": "string", "minLength": 1},
    "decision_scope": {"enum": ["NEW_ENTRY", "HOLDING"]},
    "original_thesis_id": {"type": ["string", "null"]},
    "decision": {"enum": ["ENTRY_VALID", "WAIT", "CANCEL_ENTRY", "PRICE_OUTSIDE_ENTRY_RANGE", "NO_NEW_POSITION", "HOLD", "HOLD_RAISE_STOP", "HOLD_EXTEND_TARGET", "RISK_REVIEW", "REDUCE", "EXIT"]},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "historical_analogue_id": {"type": ["string", "null"]},
    "market_context_id": {"type": "string", "minLength": 1},
    "portfolio_context_id": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "human_readable_explanation": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "authority_mode": {"const": "SHADOW_ONLY"}
  },
  "allOf": [
    {"if": {"properties": {"decision_scope": {"const": "NEW_ENTRY"}}}, "then": {"properties": {"decision": {"enum": ["ENTRY_VALID", "WAIT", "CANCEL_ENTRY", "PRICE_OUTSIDE_ENTRY_RANGE", "NO_NEW_POSITION"]}}}},
    {"if": {"properties": {"decision_scope": {"const": "HOLDING"}}}, "then": {"properties": {"decision": {"enum": ["HOLD", "HOLD_RAISE_STOP", "HOLD_EXTEND_TARGET", "RISK_REVIEW", "REDUCE", "EXIT"]}, "original_thesis_id": {"type": "string", "minLength": 1}}}}
  ]
}
