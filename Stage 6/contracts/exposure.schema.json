{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage6/exposure.schema.json",
  "title": "Stage 6 Exposure Graph Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exposure_id", "company_id", "sector", "subsector", "as_of_timestamp", "assertions", "relationships"],
  "properties": {
    "schema_version": {"const": "STAGE6_EXPOSURE_V1"},
    "exposure_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "sector": {"type": "string", "minLength": 1},
    "subsector": {"type": ["string", "null"]},
    "as_of_timestamp": {"type": "string", "format": "date-time"},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}
  },
  "$defs": {
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["exposure_type", "value", "evidence_id", "confidence", "effective_date", "review_or_expiry_date"],
      "properties": {
        "exposure_type": {"enum": ["REVENUE_GEOGRAPHY", "EXPORT_DEPENDENCY", "IMPORT_DEPENDENCY", "CURRENCY", "COMMODITY", "ENERGY_SENSITIVITY", "INTEREST_RATE_SENSITIVITY", "GOVERNMENT_SPENDING", "MAJOR_CUSTOMER_INDUSTRY", "MAJOR_SUPPLIER_INDUSTRY", "GEOPOLITICAL"]},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "evidence_id": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "effective_date": {"type": "string", "format": "date"},
        "review_or_expiry_date": {"type": "string", "format": "date"}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_type", "related_entity_id", "evidence_id", "confidence", "effective_date", "review_or_expiry_date"],
      "properties": {
        "relationship_type": {"enum": ["PARENT", "SUBSIDIARY", "GROUP_COMPANY"]},
        "related_entity_id": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "effective_date": {"type": "string", "format": "date"},
        "review_or_expiry_date": {"type": "string", "format": "date"}
      }
    }
  }
}
