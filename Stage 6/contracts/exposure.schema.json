{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage6/exposure.schema.json",
  "title": "Stage 6 Versioned Exposure Graph Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exposure_id", "exposure_version", "company_entity_id", "sector_entity_id", "subsector_entity_id", "as_of_timestamp", "data_cutoff_timestamp", "entity_registry_snapshot_id", "entity_registry_version", "entity_registry_hash", "input_evidence_ids", "assertions", "relationships", "previous_version_hash", "record_hash"],
  "properties": {
    "schema_version": {"const": "STAGE6_EXPOSURE_V2"},
    "exposure_id": {"type": "string", "minLength": 1},
    "exposure_version": {"type": "integer", "minimum": 1},
    "company_entity_id": {"type": "string", "minLength": 1},
    "sector_entity_id": {"type": "string", "minLength": 1},
    "subsector_entity_id": {"type": ["string", "null"]},
    "as_of_timestamp": {"type": "string", "format": "date-time"},
    "data_cutoff_timestamp": {"type": "string", "format": "date-time"},
    "entity_registry_snapshot_id": {"type": "string", "minLength": 1},
    "entity_registry_version": {"type": "integer", "minimum": 1},
    "entity_registry_hash": {"$ref": "#/$defs/hash"},
    "input_evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "previous_version_hash": {"$ref": "#/$defs/nullable_hash"},
    "record_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "basis", "declared_unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"enum": ["PERCENT_REVENUE", "FRACTION_REVENUE", "PERCENT_COST", "FRACTION_COST", "INR", "USD", "PERCENT_IMPORTS", "PERCENT_EXPORTS", "PERCENT_DEBT", "BASIS_POINTS", "CORRELATION", "BETA_SENSITIVITY", "OTHER_DECLARED"]},
        "basis": {"type": "string", "minLength": 1},
        "declared_unit": {"type": ["string", "null"]}
      },
      "allOf": [{"if": {"properties": {"unit": {"const": "OTHER_DECLARED"}}, "required": ["unit"]}, "then": {"properties": {"declared_unit": {"type": "string", "minLength": 1}}}, "else": {"properties": {"declared_unit": {"const": null}}}}]
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["exposure_type", "value_type", "measurement", "qualitative_value", "evidence_ids", "confidence", "effective_date", "review_or_expiry_date"],
      "properties": {
        "exposure_type": {"enum": ["REVENUE_GEOGRAPHY", "EXPORT_DEPENDENCY", "IMPORT_DEPENDENCY", "CURRENCY", "COMMODITY", "ENERGY_SENSITIVITY", "INTEREST_RATE_SENSITIVITY", "GOVERNMENT_SPENDING", "MAJOR_CUSTOMER_INDUSTRY", "MAJOR_SUPPLIER_INDUSTRY", "GEOPOLITICAL", "DEBT_SENSITIVITY", "FREIGHT_SENSITIVITY", "INPUT_COST_SENSITIVITY"]},
        "value_type": {"enum": ["QUANTITATIVE", "QUALITATIVE"]},
        "measurement": {"oneOf": [{"$ref": "#/$defs/measurement"}, {"type": "null"}]},
        "qualitative_value": {"enum": ["LOW", "MEDIUM", "HIGH", "MIXED", "UNKNOWN", null]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "effective_date": {"type": "string", "format": "date"},
        "review_or_expiry_date": {"type": "string", "format": "date"}
      },
      "allOf": [
        {"if": {"properties": {"value_type": {"const": "QUANTITATIVE"}}, "required": ["value_type"]}, "then": {"properties": {"measurement": {"$ref": "#/$defs/measurement"}, "qualitative_value": {"const": null}}}},
        {"if": {"properties": {"value_type": {"const": "QUALITATIVE"}}, "required": ["value_type"]}, "then": {"properties": {"measurement": {"const": null}, "qualitative_value": {"enum": ["LOW", "MEDIUM", "HIGH", "MIXED", "UNKNOWN"]}}}}
      ]
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_type", "related_entity_id", "evidence_ids", "confidence", "effective_date", "review_or_expiry_date"],
      "properties": {"relationship_type": {"enum": ["PARENT", "SUBSIDIARY", "GROUP_COMPANY"]}, "related_entity_id": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "effective_date": {"type": "string", "format": "date"}, "review_or_expiry_date": {"type": "string", "format": "date"}}
    }
  },
  "x-stage6-invariants": [
    "company, sector, subsector, and related entities must exist in the referenced immutable entity-registry snapshot.",
    "Quantitative assertions require explicit measurement value, unit, and basis; OTHER_DECLARED requires declared_unit.",
    "Qualitative LOW/MEDIUM/HIGH/MIXED/UNKNOWN values have no implicit numeric scores.",
    "data_cutoff_timestamp must not be after as_of_timestamp, and effective_date must not be after review_or_expiry_date; runtime validation enforces chronology.",
    "Exposure versions are append-only and linked by previous_version_hash."
  ]
}
